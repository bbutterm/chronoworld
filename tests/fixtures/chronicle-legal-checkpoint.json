"},{"equippedBy":"h2","id":"it294","itemId":"valkyrie_armor"},{"equippedBy":"h12","id":"it295","itemId":"fricca_circlet"},{"equippedBy":"h3","id":"it296","itemId":"valkyrie_boots"},{"equippedBy":"h2","id":"it297","itemId":"bloody_axe"},{"equippedBy":"h3","id":"it298","itemId":"valkyrie_armor"},{"equippedBy":"h13","id":"it299","itemId":"fricca_circlet"},{"equippedBy":"h3","id":"it300","itemId":"bloody_axe"},{"equippedBy":"h162","id":"it302","itemId":"pirate_bandana"},{"equippedBy":"h27","id":"it303","itemId":"diabolus_boots"},{"equippedBy":"h33","id":"it304","itemId":"diabolus_boots"},{"equippedBy":"h39","id":"it305","itemId":"diabolus_boots"},{"equippedBy":"h173","id":"it306","itemId":"kitsune_mask"},{"equippedBy":"h25","id":"it307","itemId":"abyss_blade"},{"equippedBy":"h171","id":"it308","itemId":"gladius"},{"equippedBy":"h7","id":"it309","itemId":"bloody_axe"},{"equippedBy":"h15","id":"it310","itemId":"fricca_circlet"},{"equippedBy":"h80","id":"it311","itemId":"diabolus_boots"},{"equippedBy":"h7","id":"it312","itemId":"valkyrie_armor"},{"equippedBy":"h25","id":"it313","itemId":"fricca_circlet"},{"equippedBy":"h7","id":"it314","itemId":"valkyrie_boots"},{"equippedBy":"h102","id":"it315","itemId":"diabolus_boots"},{"equippedBy":"h8","id":"it316","itemId":"valkyrie_boots"}],"refineSeq":264},"mail":{"delivered":["welcome","world_changed_1","world_changed_2","story_ch1_done","story_ch2_done","story_ch3_done","story_ch4_done"],"letters":[{"body":"Командир, гонец из Моррока загнал второго коня — на этот раз с хорошими вестями. Пирамида спит, мумии легли, город над печатью стоит.\n\nБран прислал зарисовку фрески: боги кладут рогатого под пески и строят над ним город. «Узел», «печать», «стражи» — я слышал эти слова раньше, и не от жрецов.\n\nОсирис говорил о лисе на востоке. Это Пайон. Отдохни день — и в путь.","claimed":true,"day":"2026-10-08","from":"Гаррет","id":"m5","read":true,"rewards":{"gold":2000,"jobExp":2000},"source":"story_ch4_done","title":"Моррок стоит"},{"body":"Командиру отряда из Пронтеры.\n\nАрхив Гефенской башни получил копии обрядов орочьей деревни. Пометка «сорок лет не выходили на дороги» подтверждается: орки держали клятву вождей, пока её кто-то не сорвал. Кто и зачем — в наших книгах ответа нет.\n\nПросим: встретите ещё такие рогатые знаки — зарисуйте. Башня оплатит бумагу и чернила.","claimed":true,"day":"2026-10-07","from":"Архив Гефенской башни","id":"m4","read":true,"rewards":{"gold":1500,"jobExp":1500},"source":"story_ch3_done","title":"Записи об обрядах орков"},{"body":"Уважаемый командир!\n\nСлужба Кафра благодарит ваш отряд за очищенные стоки: склады под Южными воротами снова сухие, а жуки больше не выносят посылки клиентов по частям.\n\nНаш писарь при описи нашёл пустой ящик из-под песка с припиской «Гефен, на запад». Возвращаем его вам — вам он, кажется, нужнее.\n\nС уважением, Служба Кафра. Мы всегда рядом!","claimed":true,"day":"2026-10-07","from":"Служба Кафра","id":"m3","read":true,"rewards":{"gold":1000,"jobExp":1000},"source":"story_ch2_done","title":"Благодарность от Службы Кафра"},{"body":"Командир, луга снова пахнут травой, а не порингами. Бруно плакал в фартук и налил всем за счёт заведения — Бран записал, что это первый раз за двадцать лет.\n\nКолокольчик я видел. Знак на нём мне знаком, и мне это не нравится. Следы серого уходят под мостовую — по королевскому указу новички как раз чистят стоки. Бери лампы и сапоги повыше.\n\nВо вложении — на лампы и сапоги.","claimed":true,"day":"2026-10-05","from":"Гаррет","id":"m2","read":true,"rewards":{"gold":800},"source":"story_ch1_done","title":"Король порингов повержен"},{"body":"Рад, что ты с нами, командир. Поринги на южных лугах взбесились, и нам нужен каждый клинок.\n\nЗаходи в лагерь каждый день: за вход положены награды, а за первые семь дней — ещё и задания новичка. В конце обоих ждут «Контракты героя»: фиолетовый герой на твой выбор.\n\nВо вложении — немного на первое время.","claimed":true,"day":"2026-10-05","from":"Гаррет","id":"m1","read":true,"rewards":{"gold":500,"jobExp":500},"source":"welcome","title":"Добро пожаловать в лагерь!"}],"seq":5},"offline":{"banked":{"gold":50535,"jobExp":71940,"minutes":15},"lastClaimAt":1792505594606},"presets":[],"resources":{"gold":23918,"heroExp":37683644},"seenScenes":["ch1_s11_after","ch1_s4_after","ch1_s5_after","ch1_s6_after","ch1_s15_after","ch1_s16_after","ch1_outro","ch2c_s11_after","ch2c_s2_after","ch2c_s13_after","ch2c_s5_after","ch2c_s15_after","ch2c_s7_after","ch2c_s17_after","ch2c_outro","ch3o_s11_after","ch3o_s12_after","ch3o_s3_after","ch3o_s14_after","ch3o_s15_after","ch3o_s6_after","ch3o_s16_after","ch3o_s18_after","ch3o_outro","ch4_s11_after","ch4_s4_after","ch4_s5_after","ch4_s7_after","ch4_s15_after","ch4_outro","ch5_s1_after","ch5_s11_after","ch5_s5_after","ch5_s15_after","ch5_s16_after","ch5_outro","ch6_s1_after","ch6_s11_after","ch6_s5_after","ch6_s7_after","ch6_s15_after","ch6_outro","ch7a_s2_after","ch7a_s11_after","ch7a_s12_after","ch7a_s14_after","ch7a_s15_after","ch7a_s17_after","ch7a_outro","ch8_s3_after","ch8_s4_after","ch8_s6_after","ch8_s9_after","ch8_s14_after","ch8_s15_after","ch8_s16_after","ch8_outro","ch9_s2_after","ch9_s4_after","ch9_s6_after","ch9_s8_after","ch9_s11_after","ch9_s14_after","ch9_s15_after","ch9_s16_after","ch9_outro","ch10_s1_after","ch10_s3_after","ch10_s6_after","ch10_s7_after","ch10_s8_after","ch10_s13_after","ch10_s14_after","ch10_s16_after","ch10_outro"],"seenUnlocks":[],"shop":{"boughtToday":{"card_blue":1,"scroll":1},"day":"2026-10-20","refreshes":1,"slots":[{"bought":0,"count":30000,"currency":"gold","good":"exp_small","kind":"heroExp","price":30000,"stock":2},{"bought":0,"count":80000,"currency":"gold","good":"exp_large","kind":"heroExp","price":80000,"stock":1},{"bought":0,"count":1,"currency":"gold","good":"item_common","itemId":"sandals","kind":"item","price":15000,"stock":1},{"bought":0,"count":1,"currency":"gold","good":"item_common","itemId":"shoes","kind":"item","price":15000,"stock":1},{"bou