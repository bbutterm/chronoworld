{
  "title": "Лавка (товары и обновление)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "slots": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "refresh": {
      "type": "object",
      "properties": {
        "gemCosts": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "maxPerDay": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "gemCosts",
        "maxPerDay"
      ]
    },
    "chapterGrowth": {
      "type": "number",
      "minimum": 0
    },
    "goods": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "item",
              "shards",
              "heroExp",
              "scrolls",
              "gold"
            ]
          },
          "rarity": {
            "type": "string",
            "enum": [
              "common",
              "rare",
              "epic"
            ]
          },
          "count": {
            "default": 1,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "price": {
            "type": "object",
            "properties": {
              "currency": {
                "type": "string",
                "enum": [
                  "gold",
                  "gems"
                ]
              },
              "amount": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "currency",
              "amount"
            ]
          },
          "stock": {
            "default": 1,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "fromStage": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "perDay": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "kind",
          "price",
          "weight"
        ]
      }
    }
  },
  "required": [
    "slots",
    "refresh",
    "chapterGrowth",
    "goods"
  ]
}
