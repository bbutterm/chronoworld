{
  "title": "Охота на босса",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "attemptsPerDay": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "timeLimitSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "sweep": {
      "default": true,
      "type": "boolean"
    },
    "slot": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "bosses": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unit": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "hpMult": {
            "default": 1,
            "type": "number",
            "exclusiveMinimum": 0
          },
          "atkMult": {
            "default": 1,
            "type": "number",
            "exclusiveMinimum": 0
          },
          "defMult": {
            "default": 1,
            "type": "number",
            "exclusiveMinimum": 0
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 4
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "legend": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140
          },
          "mechanics": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 56
            }
          },
          "card": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "legacy": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "required": [
          "unit"
        ]
      }
    },
    "tiers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "damage": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "rewards": {
            "type": "object",
            "properties": {
              "gold": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "jobExp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "gems": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "heroCards": {
                "type": "object",
                "properties": {
                  "blue": {
                    "type": "number",
                    "minimum": 0
                  },
                  "purple": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "item": {
                "type": "string",
                "enum": [
                  "common",
                  "rare",
                  "epic"
                ]
              }
            }
          }
        },
        "required": [
          "damage",
          "rewards"
        ]
      }
    },
    "mvp": {
      "type": "object",
      "properties": {
        "weaknessAtk": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "armorAtk": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 0.9
        },
        "startRank": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "jump": {
          "default": 0.8,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cardChance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cardPity": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "ranks": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hp": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "atk": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "def": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "hp",
              "atk",
              "def"
            ]
          }
        }
      },
      "required": [
        "weaknessAtk",
        "cardChance",
        "cardPity",
        "ranks"
      ]
    },
    "cards": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "slot": {
            "type": "string",
            "enum": [
              "weapon",
              "armor",
              "helmet",
              "boots"
            ]
          },
          "bonus": {
            "type": "object",
            "properties": {
              "hp": {
                "type": "number",
                "minimum": -0.5,
                "maximum": 1
              },
              "atk": {
                "type": "number",
                "minimum": -0.5,
                "maximum": 1
              },
              "def": {
                "type": "number",
                "minimum": -0.5,
                "maximum": 1
              },
              "spd": {
                "type": "number",
                "minimum": -0.5,
                "maximum": 1
              }
            }
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 90
          }
        },
        "required": [
          "id",
          "name",
          "slot",
          "bonus",
          "text"
        ]
      }
    }
  },
  "required": [
    "attemptsPerDay",
    "timeLimitSeconds",
    "bosses",
    "tiers"
  ]
}
