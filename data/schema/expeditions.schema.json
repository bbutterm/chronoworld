{
  "title": "Экспедиции по локациям и лимиты пресетов",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "maxHeroes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "durations": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hours": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "bonus": {
            "default": 0,
            "type": "number",
            "minimum": 0,
            "maximum": 2
          }
        },
        "required": [
          "hours"
        ]
      }
    },
    "locations": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "power": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "tint": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "monster": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "monsterScale": {
            "type": "number",
            "minimum": 0.3,
            "maximum": 2
          },
          "perHour": {
            "type": "object",
            "properties": {
              "gold": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "jobExp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "gold",
              "jobExp"
            ]
          },
          "loot": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "item",
                    "gems",
                    "heroCard",
                    "scrolls"
                  ]
                },
                "rarity": {
                  "type": "string",
                  "enum": [
                    "blue",
                    "purple"
                  ]
                },
                "chance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "count": {
                  "default": 1,
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  }
                }
              },
              "required": [
                "kind",
                "chance"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "stage",
          "power",
          "tint",
          "perHour"
        ]
      }
    },
    "presets": {
      "type": "object",
      "properties": {
        "max": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "nameMaxLength": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "max",
        "nameMaxLength"
      ]
    }
  },
  "required": [
    "maxHeroes",
    "durations",
    "locations",
    "presets"
  ]
}
