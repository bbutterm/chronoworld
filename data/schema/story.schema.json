{
  "title": "Сюжет главы",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "chapter": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "speakers": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "portrait": {
            "type": "string",
            "minLength": 1
          },
          "illust": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "required": [
          "name",
          "portrait"
        ]
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "trigger": {
            "type": "string",
            "enum": [
              "chapterStart",
              "beforeStage",
              "afterStage"
            ]
          },
          "stageId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "bossIntro": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "subtitle": {
                "type": "string"
              }
            },
            "required": [
              "title"
            ]
          },
          "lines": {
            "minItems": 1,
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "speaker": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "required": [
                "speaker",
                "text"
              ]
            }
          }
        },
        "required": [
          "id",
          "trigger",
          "lines"
        ]
      }
    }
  },
  "required": [
    "chapter",
    "speakers",
    "scenes"
  ]
}
