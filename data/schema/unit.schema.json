{
  "title": "Юнит (герой, монстр, босс)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "hero",
        "monster",
        "boss"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "tank",
        "damage",
        "healer",
        "support"
      ]
    },
    "stats": {
      "type": "object",
      "properties": {
        "hp": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "atk": {
          "type": "number",
          "minimum": 0
        },
        "def": {
          "type": "number",
          "minimum": 0
        },
        "spd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "moveSpeed": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "hp",
        "atk",
        "def",
        "spd"
      ]
    },
    "skills": {
      "type": "object",
      "properties": {
        "basic": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "ult": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "actives": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "passives": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      },
      "required": [
        "basic"
      ]
    },
    "visual": {
      "type": "object",
      "properties": {
        "sprite": {
          "type": "string"
        },
        "projectile": {
          "type": "string"
        },
        "hitFx": {
          "type": "string"
        },
        "tint": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4
        }
      },
      "required": [
        "sprite"
      ]
    },
    "bodyRadius": {
      "type": "number",
      "minimum": 0
    },
    "energy": {
      "type": "object",
      "properties": {
        "perSecond": {
          "type": "number",
          "minimum": 0
        },
        "perBasicAction": {
          "type": "number",
          "minimum": 0
        },
        "perHitTaken": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "perSecond",
        "perBasicAction",
        "perHitTaken"
      ]
    },
    "skillPower": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "barks": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "half": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "defeat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "victory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "rage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "behavior": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "phases": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "atHpPct": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          },
          "atSeconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "bark": {
            "type": "string",
            "enum": [
              "half",
              "rage"
            ]
          },
          "actions": {
            "minItems": 1,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "addActive"
                    },
                    "skill": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    }
                  },
                  "required": [
                    "type",
                    "skill"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "status"
                    },
                    "status": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*$"
                        },
                        "name": {
                          "type": "string"
                        },
                        "turns": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "stats": {
                          "type": "object",
                          "properties": {
                            "atk": {
                              "type": "number"
                            },
                            "def": {
                              "type": "number"
                            },
                            "spd": {
                              "type": "number"
                            }
                          },
                          "description": "Модификаторы статов в долях: 0.2 = +20%, -0.3 = −30%"
                        },
                        "stun": {
                          "type": "boolean"
                        },
                        "dot": {
                          "type": "object",
                          "properties": {
                            "k": {
                              "type": "number",
                              "exclusiveMinimum": 0
                            }
                          },
                          "required": [
                            "k"
                          ]
                        },
                        "taunt": {
                          "type": "boolean"
                        },
                        "interrupt": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "turns"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "status"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "energy"
                    },
                    "amount": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "type",
                    "amount"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "shield"
                    },
                    "pctMaxHp": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "type",
                    "pctMaxHp"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "summon"
                    },
                    "unit": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4
                    },
                    "hp": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1
                    },
                    "atk": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 2
                    },
                    "def": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 2
                    }
                  },
                  "required": [
                    "type",
                    "unit",
                    "count",
                    "hp",
                    "atk"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "title",
          "actions"
        ]
      }
    },
    "element": {
      "type": "string",
      "enum": [
        "neutral",
        "fire",
        "water",
        "earth",
        "wind",
        "holy",
        "dark",
        "undead"
      ]
    },
    "charge": {
      "type": "object",
      "properties": {
        "skill": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "first": {
          "type": "number",
          "minimum": 0
        },
        "every": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "skill",
        "first",
        "every"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "kind",
    "role",
    "stats",
    "skills",
    "visual"
  ]
}
