{
  "title": "Юнит (герой, монстр, босс)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "hero",
        "monster",
        "boss"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "tank",
        "damage",
        "healer",
        "support"
      ]
    },
    "stats": {
      "type": "object",
      "properties": {
        "hp": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "atk": {
          "type": "number",
          "minimum": 0
        },
        "def": {
          "type": "number",
          "minimum": 0
        },
        "spd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "moveSpeed": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "hp",
        "atk",
        "def",
        "spd"
      ]
    },
    "skills": {
      "type": "object",
      "properties": {
        "basic": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "ult": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "actives": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "passives": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      },
      "required": [
        "basic"
      ]
    },
    "visual": {
      "type": "object",
      "properties": {
        "sprite": {
          "type": "string"
        },
        "projectile": {
          "type": "string"
        },
        "hitFx": {
          "type": "string"
        },
        "tint": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4
        }
      },
      "required": [
        "sprite"
      ]
    },
    "bodyRadius": {
      "type": "number",
      "minimum": 0
    },
    "skillPower": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "barks": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "half": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "defeat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "victory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    }
  },
  "required": [
    "id",
    "name",
    "kind",
    "role",
    "stats",
    "skills",
    "visual"
  ]
}
