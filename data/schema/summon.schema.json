{
  "title": "Таверна (призыв карточек)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "unlockAfterStage": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "costs": {
      "type": "object",
      "properties": {
        "single": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ten": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "single",
        "ten"
      ]
    },
    "rates": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rarity": {
            "type": "string",
            "enum": [
              "green",
              "blue",
              "purple",
              "gold",
              "red"
            ]
          },
          "chance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "rarity",
          "chance"
        ]
      }
    },
    "pity": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rarity": {
            "type": "string",
            "enum": [
              "blue",
              "purple"
            ]
          },
          "every": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "rarity",
          "every"
        ]
      }
    },
    "loot": {
      "default": [],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "gear"
              },
              "chance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "blueChance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "kind",
              "chance",
              "blueChance"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "heroExp",
                  "gold"
                ]
              },
              "chance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minutes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "chance",
              "minutes"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "gems"
              },
              "chance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "min": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "max": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "chance",
              "min",
              "max"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "ore"
              },
              "chance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "kind",
              "chance"
            ]
          }
        ]
      }
    },
    "newHeroWeight": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "firstTen": {
      "type": "object",
      "properties": {
        "rarity": {
          "type": "string",
          "enum": [
            "green",
            "blue",
            "purple",
            "gold",
            "red"
          ]
        },
        "count": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "heroes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 10
        }
      },
      "required": [
        "rarity",
        "count"
      ]
    },
    "freePerDay": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "welcome": {
      "type": "object",
      "properties": {
        "gems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scrolls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "purplePity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "gems",
        "scrolls"
      ]
    }
  },
  "required": [
    "costs",
    "rates",
    "pity",
    "firstTen",
    "freePerDay",
    "welcome"
  ]
}
