{
  "title": "События новичка и системные письма",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "login": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "days": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rewards": {
                "type": "object",
                "properties": {
                  "gold": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "gems": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "jobExp": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "scrolls": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "heroes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "heroCards": {
                    "type": "object",
                    "properties": {
                      "blue": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "purple": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    }
                  },
                  "heroPicks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "rarity": {
                          "type": "string",
                          "enum": [
                            "green",
                            "blue",
                            "purple",
                            "gold",
                            "red"
                          ]
                        }
                      },
                      "required": [
                        "rarity"
                      ]
                    }
                  }
                }
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "rewards"
            ]
          }
        }
      },
      "required": [
        "name",
        "days"
      ]
    },
    "newbie": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "durationDays": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "graceDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "days": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tasks": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "name": {
                      "type": "string"
                    },
                    "counter": {
                      "type": "string",
                      "enum": [
                        "stages_cleared",
                        "tower_floor",
                        "items_equipped",
                        "bounties_done",
                        "battles_won",
                        "hero_max_level",
                        "summons",
                        "ascensions"
                      ]
                    },
                    "target": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "points": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "counter",
                    "target",
                    "points"
                  ]
                }
              }
            },
            "required": [
              "tasks"
            ]
          }
        },
        "milestones": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "points": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "rewards": {
                "type": "object",
                "properties": {
                  "gold": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "gems": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "jobExp": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "scrolls": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "heroes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "heroCards": {
                    "type": "object",
                    "properties": {
                      "blue": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "purple": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    }
                  },
                  "heroPicks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "rarity": {
                          "type": "string",
                          "enum": [
                            "green",
                            "blue",
                            "purple",
                            "gold",
                            "red"
                          ]
                        }
                      },
                      "required": [
                        "rarity"
                      ]
                    }
                  }
                }
              }
            },
            "required": [
              "points",
              "rewards"
            ]
          }
        }
      },
      "required": [
        "name",
        "durationDays",
        "graceDays",
        "days",
        "milestones"
      ]
    },
    "mail": {
      "type": "object",
      "properties": {
        "letters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "from": {
                "default": "Гаррет",
                "type": "string"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "type": "string"
              },
              "rewards": {
                "default": {},
                "type": "object",
                "properties": {
                  "gold": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "gems": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "jobExp": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "scrolls": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "heroes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "heroCards": {
                    "type": "object",
                    "properties": {
                      "blue": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "purple": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    }
                  },
                  "heroPicks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "rarity": {
                          "type": "string",
                          "enum": [
                            "green",
                            "blue",
                            "purple",
                            "gold",
                            "red"
                          ]
                        }
                      },
                      "required": [
                        "rarity"
                      ]
                    }
                  }
                }
              },
              "untilDay": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "required": [
              "id",
              "title",
              "body"
            ]
          }
        }
      },
      "required": [
        "letters"
      ]
    }
  },
  "required": [
    "login",
    "newbie",
    "mail"
  ]
}
