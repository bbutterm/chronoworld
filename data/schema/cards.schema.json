{
  "title": "Редкости, уровень и вознесение карточек",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "rarities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "green",
              "blue",
              "purple",
              "gold",
              "red"
            ]
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "maxLevel": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "statMult": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "skillPower": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id",
          "name",
          "color",
          "maxLevel",
          "statMult",
          "skillPower"
        ]
      }
    },
    "level": {
      "type": "object",
      "properties": {
        "exp": {
          "type": "object",
          "properties": {
            "base": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "power": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "base",
            "power"
          ]
        },
        "gold": {
          "type": "object",
          "properties": {
            "base": {
              "type": "number",
              "minimum": 0
            },
            "power": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "base",
            "power"
          ]
        }
      },
      "required": [
        "exp",
        "gold"
      ]
    },
    "merge": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "enum": [
              "green",
              "blue",
              "purple",
              "gold",
              "red"
            ]
          },
          "to": {
            "type": "string",
            "enum": [
              "green",
              "blue",
              "purple",
              "gold",
              "red"
            ]
          },
          "gold": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "fodder": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "same",
                    "any"
                  ]
                },
                "rarity": {
                  "type": "string",
                  "enum": [
                    "green",
                    "blue",
                    "purple",
                    "gold",
                    "red"
                  ]
                },
                "count": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "kind",
                "rarity",
                "count"
              ]
            }
          },
          "branch": {
            "type": "boolean"
          }
        },
        "required": [
          "from",
          "to",
          "gold",
          "fodder"
        ]
      }
    },
    "branchChange": {
      "type": "object",
      "properties": {
        "gems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "firstFree": {
          "type": "boolean"
        }
      },
      "required": [
        "gems",
        "firstFree"
      ]
    },
    "training": {
      "type": "object",
      "properties": {
        "unlockLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "focuses": {
          "minItems": 3,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "resolve",
                  "precision",
                  "guard"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180
              },
              "stat": {
                "type": "string",
                "enum": [
                  "hp",
                  "atk",
                  "def"
                ]
              },
              "pct": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              }
            },
            "required": [
              "id",
              "name",
              "text",
              "stat",
              "pct"
            ]
          }
        }
      },
      "required": [
        "unlockLevel",
        "focuses"
      ]
    },
    "heroCards": {
      "type": "object",
      "properties": {
        "firstClear": {
          "type": "object",
          "properties": {
            "blue": {
              "type": "number",
              "minimum": 0
            },
            "purple": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "bossFirstClear": {
          "type": "object",
          "properties": {
            "blue": {
              "type": "number",
              "minimum": 0
            },
            "purple": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "replay": {
          "type": "object",
          "properties": {
            "blue": {
              "type": "number",
              "minimum": 0
            },
            "purple": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      },
      "required": [
        "firstClear",
        "bossFirstClear",
        "replay"
      ]
    }
  },
  "required": [
    "rarities",
    "level",
    "merge",
    "branchChange",
    "heroCards"
  ]
}
