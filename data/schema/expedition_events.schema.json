{
  "title": "События экспедиций (текстовые приключения)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "perExpedition": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "maxHours": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        },
        "required": [
          "maxHours",
          "count"
        ]
      }
    },
    "tiers": {
      "type": "object",
      "properties": {
        "none": {
          "type": "number",
          "const": 0
        },
        "small": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "medium": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "big": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "loss": {
          "type": "number",
          "minimum": -1,
          "maximum": 0
        }
      },
      "required": [
        "none",
        "small",
        "medium",
        "big",
        "loss"
      ]
    },
    "journalMax": {
      "default": 40,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "localWeight": {
      "default": 2,
      "type": "number",
      "exclusiveMinimum": 0
    },
    "events": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36
          },
          "locations": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 420
          },
          "choices": {
            "minItems": 2,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 34
                },
                "requires": {
                  "type": "object",
                  "properties": {
                    "line": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$"
                      }
                    },
                    "role": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "tank",
                          "damage",
                          "healer",
                          "support"
                        ]
                      }
                    },
                    "hero": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$"
                      }
                    }
                  }
                },
                "chance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "chanceWith": {
                  "default": 0.95,
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "default": {
                  "default": false,
                  "type": "boolean"
                },
                "success": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 280
                    },
                    "reward": {
                      "default": "none",
                      "type": "string",
                      "enum": [
                        "none",
                        "small",
                        "medium",
                        "big",
                        "loss"
                      ]
                    },
                    "item": {
                      "default": false,
                      "type": "boolean"
                    },
                    "gems": {
                      "default": 0,
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10
                    },
                    "lore": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "wound": {
                      "default": false,
                      "type": "boolean"
                    },
                    "bond": {
                      "default": false,
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "text"
                  ]
                },
                "fail": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 280
                    },
                    "reward": {
                      "default": "none",
                      "type": "string",
                      "enum": [
                        "none",
                        "small",
                        "medium",
                        "big",
                        "loss"
                      ]
                    },
                    "item": {
                      "default": false,
                      "type": "boolean"
                    },
                    "gems": {
                      "default": 0,
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10
                    },
                    "lore": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "wound": {
                      "default": false,
                      "type": "boolean"
                    },
                    "bond": {
                      "default": false,
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "text"
                  ]
                }
              },
              "required": [
                "id",
                "label",
                "chance",
                "success"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "text",
          "choices"
        ]
      }
    }
  },
  "required": [
    "perExpedition",
    "tiers",
    "events"
  ]
}
