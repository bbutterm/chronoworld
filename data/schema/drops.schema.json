{
  "title": "Выпадение предметов и трофеи сундука",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "rules": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chapter": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "chance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rarityWeights": {
            "type": "object",
            "properties": {
              "common": {
                "type": "number",
                "minimum": 0
              },
              "rare": {
                "type": "number",
                "minimum": 0
              },
              "epic": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "firstClearGuaranteed": {
            "default": true,
            "type": "boolean"
          },
          "firstClearRarityWeights": {
            "type": "object",
            "properties": {
              "common": {
                "type": "number",
                "minimum": 0
              },
              "rare": {
                "type": "number",
                "minimum": 0
              },
              "epic": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "bossFirstClearRarityWeights": {
            "type": "object",
            "properties": {
              "common": {
                "type": "number",
                "minimum": 0
              },
              "rare": {
                "type": "number",
                "minimum": 0
              },
              "epic": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "itemsFromChapter": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "chance",
          "rarityWeights"
        ]
      }
    },
    "chest": {
      "type": "object",
      "properties": {
        "tickMinutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 720
        },
        "rules": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "chapter": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "item": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "itemsFromChapter": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "rarityWeights": {
                "type": "object",
                "properties": {
                  "common": {
                    "type": "number",
                    "minimum": 0
                  },
                  "rare": {
                    "type": "number",
                    "minimum": 0
                  },
                  "epic": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "heroCards": {
                "type": "object",
                "properties": {
                  "blue": {
                    "default": 0,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "purple": {
                    "default": 0,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "gems": {
                "type": "object",
                "properties": {
                  "chance": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "chance",
                  "count"
                ]
              },
              "scrolls": {
                "type": "object",
                "properties": {
                  "chance": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "chance",
                  "count"
                ]
              }
            },
            "required": [
              "item"
            ]
          }
        }
      },
      "required": [
        "tickMinutes",
        "rules"
      ]
    },
    "refine": {
      "type": "object",
      "properties": {
        "maxLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "bonusByLevel": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 20
          }
        },
        "cost": {
          "type": "object",
          "properties": {
            "base": {
              "type": "object",
              "properties": {
                "common": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "rare": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "epic": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "common",
                "rare",
                "epic"
              ]
            },
            "growth": {
              "type": "number",
              "minimum": 1,
              "maximum": 4
            }
          },
          "required": [
            "base",
            "growth"
          ]
        },
        "breakChance": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.99
          }
        },
        "safeGoldMult": {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "safeBreakDiv": {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "blessedOre": {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [
            "min",
            "max"
          ]
        }
      },
      "required": [
        "maxLevel",
        "bonusByLevel",
        "cost"
      ]
    }
  },
  "required": [
    "rules"
  ]
}
