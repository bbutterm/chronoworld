{
  "title": "Глава кампании",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "stages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string"
          },
          "boss": {
            "default": false,
            "type": "boolean"
          },
          "inserted": {
            "type": "boolean"
          },
          "enemies": {
            "minItems": 5,
            "maxItems": 5,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "unit": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "mult": {
                      "default": 1,
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "unit"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "rewards": {
            "type": "object",
            "properties": {
              "jobExp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "gold": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "jobExp",
              "gold"
            ]
          },
          "offlinePerMinute": {
            "type": "object",
            "properties": {
              "jobExp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "gold": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "jobExp",
              "gold"
            ]
          },
          "finding": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "kind": {
                "default": "note",
                "type": "string",
                "enum": [
                  "note",
                  "inscription",
                  "rumor",
                  "item"
                ]
              },
              "comment": {
                "type": "object",
                "properties": {
                  "speaker": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "required": [
                  "speaker",
                  "text"
                ]
              }
            },
            "required": [
              "id",
              "title",
              "text"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "enemies",
          "rewards",
          "offlinePerMinute"
        ]
      }
    },
    "episode": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 900
        }
      },
      "required": [
        "title",
        "text"
      ]
    },
    "legend": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "title",
        "text"
      ]
    },
    "chronicle": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        }
      },
      "required": [
        "title",
        "text"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "order",
    "stages"
  ]
}
