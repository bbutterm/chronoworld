{
  "title": "Глава кампании",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "stages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string"
          },
          "boss": {
            "default": false,
            "type": "boolean"
          },
          "enemies": {
            "minItems": 5,
            "maxItems": 5,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "unit": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "mult": {
                      "default": 1,
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "unit"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "rewards": {
            "type": "object",
            "properties": {
              "jobExp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "gold": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "jobExp",
              "gold"
            ]
          },
          "offlinePerMinute": {
            "type": "object",
            "properties": {
              "jobExp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "gold": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "jobExp",
              "gold"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "enemies",
          "rewards",
          "offlinePerMinute"
        ]
      }
    }
  },
  "required": [
    "id",
    "name",
    "order",
    "stages"
  ]
}
