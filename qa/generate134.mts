import {readFileSync,writeFileSync,readdirSync} from 'node:fs';
import assert from 'node:assert/strict';
import * as core from '../src/core/index.ts';
import {loadFullContext} from '../scripts/lib/content-node.ts';
import {playerSave,TOWER_SQUADS} from '../scripts/balance-tower.ts';
const ctx=loadFullContext(), out=new URL('./fixtures/',import.meta.url), day='2026-10-03';
const base=()=>{const s=playerSave(ctx,3,TOWER_SQUADS[0],17);s.createdAt=Date.now();s.offline.lastClaimAt=Date.now();s.daily.day=day;s.seenUnlocks=ctx.unlocks.features.map(x=>x.id);s.seenScenes=ctx.story.scenes.map(x=>x.id);return s;};
const cases:any={};
const art=core.startTowerRun(base(),base().squad,ctx);art.tower!.run!.pending={kind:'blessing',options:['side_winder','marse','sohee'],source:'event',rolls:0};cases['tower-new-card-art']=art;
for(const [id,level] of [['hunt-rank5',4],['hunt-max-rank',ctx.hunt.mvp!.ranks.length-1]] as const){const s=base();s.hunt={day,used:0,best:{},level};assert.equal(core.huntStatus(s,day,ctx).rank,level);assert.ok(core.huntStatus(s,day,ctx).unlocked);cases[id]=s;}
const story=base(), scene='ch3o_s15_after';const trigger=ctx.content.stages.findIndex(s=>s.id==='ch3_s15');assert.equal(ctx.content.stages[trigger+1].id,'ch3_s6');story.campaign.cleared=ctx.content.stages.slice(0,trigger+1).map(s=>s.id);story.seenScenes=story.seenScenes.filter(id=>id!==scene&&id!=='ch3o_s6_after');story.storyQueue=[scene];delete story.campaignChoices;assert.ok(core.canChooseCampaignOption(story,scene,ctx));assert.equal(core.queuedScenes(story,ctx)[0].id,scene);cases['chapter3-pilot-choice']=story;
const chosen=core.chooseCampaignOption(story,scene,'block',ctx);assert.equal(core.deserialize(core.serialize(chosen)).campaignChoices!.ch3_rescue,'block');assert.equal(core.chooseCampaignOption(chosen,scene,'evacuate',ctx).campaignChoices!.ch3_rescue,'block');const target=ctx.content.stages[trigger+1];assert.deepEqual(core.resolveStageEnemies(target,chosen.campaignChoices).map(e=>e?.unit),['orc_skeleton','orc_high','orc_archer','orc_zombie','orc_archer']);const skipped=core.finishCampaignScene(story,scene,ctx);assert.equal(skipped.campaignChoices!.ch3_rescue,'default');assert.deepEqual(core.resolveStageEnemies(target,skipped.campaignChoices),target.enemies);
for(const [id,s] of Object.entries(cases)){const parsed=core.deserialize(core.serialize(s));writeFileSync(new URL(id+'.json',out),JSON.stringify(parsed,null,2)+'\n');}
const validated=[];for(const file of readdirSync(out).filter(x=>x.endsWith('.json'))){const s=core.deserialize(readFileSync(new URL(file,out),'utf8'));if(s.tower?.run){core.towerRunSquad(s,ctx);core.towerRunFloor(s,ctx);const r=s.tower.run;for(const id of [...r.cards,...(r.pending?.kind==='blessing'?r.pending.options:[])])assert.ok(core.runConfig(ctx).blessings.some(c=>c.id===id));}validated.push(file);}
writeFileSync(new URL('./validation134.json',import.meta.url),JSON.stringify({head:'07077487777bf5ad99a9fa3d712eb2a9ae598e2d',validated,storyQueue:true,choicePersists:true,choiceImmutable:true,skipFallback:true,actualVariantEnemies:true,huntRanks:true,synthetic:true},null,2));console.log('Validated '+validated.length+' fixtures');
